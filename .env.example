# Mistral API
MISTRAL_API_KEY=sk-your-key-here
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_EMBED_MODEL=mistral-embed

# Auth (nuxt-auth-utils)
NUXT_SESSION_PASSWORD=change-me-with-at-least-32-characters-please

# DB (SQLite file path)
DATABASE_URL=data/noteforge.db

# Registration invite code (case-insensitive, default NLJELA)
INVITE_CODE=NLJELA
