# Mistral API
MISTRAL_API_KEY=sk-your-key-here
# Default chat model. Medium is ~5× cheaper than Large with very close
# RAG-grounded quality. Override to `mistral-small-latest` to go cheaper, or
# `mistral-large-latest` if you want maximum quality.
MISTRAL_CHAT_MODEL=mistral-medium-latest
MISTRAL_EMBED_MODEL=mistral-embed

# Auth (nuxt-auth-utils)
NUXT_SESSION_PASSWORD=change-me-with-at-least-32-characters-please

# DB (SQLite file path)
DATABASE_URL=data/noteforge.db

# Registration invite code (case-insensitive, default NLJELA)
INVITE_CODE=NLJELA
