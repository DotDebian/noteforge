# Claude (chat, analysis, rewrite, rerank) — through the Claude Agent SDK.
# Generate the token with `claude setup-token` (sk-ant-oat01-…). An
# ANTHROPIC_API_KEY works too; set one or the other.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-your-token-here
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# Voyage AI — embeddings (semantic search, chat retrieval, related notes).
# Without a working key, retrieval falls back to keyword matching (BM25).
# Changing the model means re-embedding everything: see docker/reembed.mjs.
VOYAGE_API_KEY=pa-your-key-here
VOYAGE_EMBED_MODEL=voyage-4-large

# Mistral API — OCR import and voice transcription only. Optional.
MISTRAL_API_KEY=

# Tavily web search (https://app.tavily.com — free tier 1000 credits/mo).
# Powers the chat's `web_search` tool; leave empty to disable web search.
TAVILY_API_KEY=tvly-your-key-here

# Auth (nuxt-auth-utils)
NUXT_SESSION_PASSWORD=change-me-with-at-least-32-characters-please

# DB (SQLite file path)
DATABASE_URL=data/noteforge.db

# Registration invite code (case-insensitive, default NLJELA)
INVITE_CODE=NLJELA
