# Hoist sqlite-vec platform binaries (sqlite-vec-linux-x64, -darwin-arm64, ...)
# to the top-level node_modules. sqlite-vec/index.mjs resolves them dynamically
# via import.meta.resolve, which Nitro's NFT can't trace — so the bundle at
# .output/server/node_modules/sqlite-vec/ relies on Node's parent-directory
# walk reaching /app/node_modules/ at runtime. Without hoisting, pnpm keeps
# them inside .pnpm/sqlite-vec@*/node_modules/ where that walk never lands.
public-hoist-pattern[]=sqlite-vec-*
