# Keep the build context to actual sources.
#
# ⚠️ `node_modules` is the important line. The Dockerfile runs
# `pnpm install --frozen-lockfile` BEFORE `COPY . .`, so without this entry the
# host's node_modules is copied over the one the image just built. pnpm 11 then
# sees a tree linked to a store path that does not exist in the image, decides
# the deps are out of sync, and tries to purge + reinstall — which aborts with
# ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY because a RUN step has no TTY.
# The image must always install its own dependencies.
node_modules
**/node_modules

# Build output — regenerated by `pnpm build` inside the image.
.output
.nuxt
.nitro
dist
.cache

# The production SQLite database (and its backups) live here and are
# bind-mounted at runtime. They have no business in a build context.
data

# Secrets. docker compose reads .env from the host, never from the image.
.env
.env.*

# Excalidraw fonts, ~14 MB, regenerated by scripts/copy-excalidraw-assets.mjs
# as part of `pnpm build`.
public/excalidraw

.git
.github
*.log
.DS_Store
